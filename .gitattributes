# Normalise to LF in the repo regardless of the committer's OS.
* text=auto eol=lf

# Windows batch scripts must stay CRLF.
*.bat text eol=crlf
*.cmd text eol=crlf

# The Maven wrapper script must be LF so it runs on macOS/Linux.
mvnw text eol=lf

# Binary files git shouldn't touch.
*.jar binary
*.pdf binary
